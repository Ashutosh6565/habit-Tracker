NODE_ENV=development
PORT=5000
# MongoDB Atlas M0 (free) connection string. Whitelist your current IP in Atlas → Network Access.
MONGODB_URI=mongodb://127.0.0.1:27017/habbiters
FRONTEND_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
COOKIE_SECRET=replace-with-a-long-random-cookie-secret

GOOGLE_CLIENT_ID=

# Email OTP delivery via Brevo free SMTP (https://app.brevo.com/settings/keys/smtp)
# Brevo: host smtp-relay.brevo.com, port 587, user = your Brevo login, pass = SMTP key.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Habbiters <no-reply@habbiters.app>"

# Support + contact inbox. Falls back to SMTP_USER / ADMIN_EMAIL when blank.
SUPPORT_EMAIL=
CONTACT_INBOX=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
STRIPE_ONETIME_PRICE_ID=

# Razorpay (INR payments) - get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret from https://dashboard.razorpay.com/app/webhooks (events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=
# External payment page used by the link + admin-approval flow.
RAZORPAY_PAYMENT_LINK=https://razorpay.me/@ashutoshkumar5863

# INR plan prices in paise (optional - defaults shown). Rs 1 = 100 paise.
# PRICE_STARTER_INR=9900
# PRICE_PREMIUM_ALL_INR=34900
# PRICE_PREMIUM_MONTHLY_INR=34900
# PRICE_PREMIUM_YEARLY_INR=199900
# PRICE_PREMIUM_LIFETIME_INR=499900

ADMIN_EMAIL=
ADMIN_PASSWORD=
